HOST=0.0.0.0
PORT=8011

# "live" scrapes bcassessment.ca; "mock" serves fixture data (tests / local dev)
LOOKUP_PROVIDER=live

# SQLite cache (run once: python scripts/setup_db.py)
DATABASE_PATH=data/bc_assessment.db
# 0 = never expire; set 31536000 for 365-day refresh
SCRAPE_CACHE_TTL_SECONDS=0
# How long a genuine "not found" is remembered before we re-scrape it
NOT_FOUND_CACHE_TTL_SECONDS=86400

# Rate limit for bcassessment.ca visits (cache hits are not limited)
BC_RATE_LIMIT_MAX=15
BC_RATE_LIMIT_WINDOW_SECONDS=60
BC_RATE_LIMIT_HOURLY_MAX=500
BC_RATE_LIMIT_HOURLY_WINDOW_SECONDS=3600
BC_RATE_LIMIT_MIN_INTERVAL_SECONDS=4
# Fraction of the hourly cap batch jobs may use (0.7 = 350 of 500)
BATCH_HOURLY_SHARE=0.7

# Telegram alerts — put the REAL token here only. This file is a template.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
STATS_MILESTONE_COUNT=100
# Minimum seconds between repeat alerts of the same failure type
ALERT_MIN_INTERVAL_SECONDS=300

# Scrape timeouts
SCRAPE_WARMUP_ON_START=true
SCRAPE_AUTOCOMPLETE_TIMEOUT_MS=8000
SCRAPE_RESULT_TIMEOUT_MS=25000
# Hard ceiling on one whole lookup (stops a stuck scrape wedging the service)
SCRAPE_TOTAL_TIMEOUT_MS=60000
SCRAPE_MAX_QUEUE_DEPTH=20
# /address returns busy (with Retry-After) instead of waiting longer than this
# for a rate-limit slot — bounds the wait at the hourly cap
SCRAPE_MAX_PROJECTED_WAIT_SECONDS=30

# Browser recycling (a fresh context is created per lookup regardless)
BROWSER_MAX_LOOKUPS=200
BROWSER_RESTART_AFTER_FAILURES=3
UNHEALTHY_AFTER_FAILURES=5

# Debug snapshots for blocked / unexpected pages
SAVE_HTML_SNAPSHOTS=true
SNAPSHOT_DIR=data/snapshots
SNAPSHOT_KEEP=50
