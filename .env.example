HOST=0.0.0.0
PORT=8011

# SQLite cache (run once: python scripts/setup_db.py)
DATABASE_PATH=data/bc_assessment.db
# 0 = never expire; set 31536000 for 365-day refresh
SCRAPE_CACHE_TTL_SECONDS=0

# Rate limit for bcassessment.ca visits (cache hits are not limited)
BC_RATE_LIMIT_MAX=10
BC_RATE_LIMIT_WINDOW_SECONDS=60
BC_RATE_LIMIT_HOURLY_MAX=1000
BC_RATE_LIMIT_HOURLY_WINDOW_SECONDS=3600
BC_RATE_LIMIT_MIN_INTERVAL_SECONDS=2

# Performance (optional)
SCRAPE_WARMUP_ON_START=true
SCRAPE_AUTOCOMPLETE_TIMEOUT_MS=8000
SCRAPE_RESULT_TIMEOUT_MS=25000
